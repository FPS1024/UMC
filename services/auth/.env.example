# Domain name that points at this server. Caddy obtains a TLS certificate
# automatically, so ports 80 and 443 must be reachable.
AUTH_DOMAIN=auth.example.com

# Database password used by PostgreSQL and the auth service.
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# Shown on the account pages and in the Yggdrasil metadata.
SERVER_NAME=Example Auth

# Required for the first account when set. Remove or change it after creating
# the administrator account.
BOOTSTRAP_TOKEN=change-this-bootstrap-token

# invite: an invite code is required
# open:   anyone may register, protected by CAPTCHA_MODE
# closed: no new registrations (the first account can still bootstrap)
REGISTRATION_MODE=invite

# off or required. required also needs the SMTP settings below.
EMAIL_VERIFICATION=off

# none, pow, or turnstile. Turnstile needs both keys.
CAPTCHA_MODE=none
POW_DIFFICULTY=16

# In-process anti-abuse limits.
REGISTER_LIMIT_PER_HOUR=3
REGISTER_LIMIT_PER_DAY=10
REGISTER_LIMIT_GLOBAL_PER_HOUR=100
LOGIN_LIMIT_PER_MINUTE=10
POW_CHALLENGE_LIMIT_PER_MINUTE=30
PROFILE_LOOKUP_LIMIT_PER_MINUTE=60
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# SMTP settings for EMAIL_VERIFICATION=required.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=UMC Auth <no-reply@auth.example.com>
# SMTP_TLS=starttls

# Go log level: debug, info, warn, error.
LOG_LEVEL=info
